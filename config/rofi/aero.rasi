* {
    bg0:      #1e1e2e;
    bg1:      #313244;
    bg2:      #45475a;
    fg0:      #cdd6f4;
    fg1:      #bac2de;
    accent:   #89b4fa;
    accent2:  #c9b0ee;
    red:      #f38ba8;
    green:    #a6e3a1;

    background-color: transparent;
    text-color: @fg0;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @bg0;
    border: 2px solid @accent;
    border-radius: 12px;
    width: 40%;
    padding: 20px;
    x-offset: 0;
    y-offset: 0;
}

prompt {
    enabled: true;
    padding: 10px 12px;
    background-color: @bg1;
    text-color: @accent;
    border-radius: 8px;
    font: "Fira Code 12";
}

inputbar {
    margin: 0 0 16px 0;
    padding: 0;
    background-color: transparent;
    text-color: @fg0;
    spacing: 0;
    children: [ prompt, entry ];
}

entry {
    margin: 0 12px;
    padding: 10px 8px;
    background-color: @bg1;
    text-color: @fg0;
    border-radius: 8px;
    placeholder: "Search...";
    placeholder-color: @fg1;
}

message {
    margin: 16px 0 0 0;
    padding: 8px;
    border-radius: 8px;
    border: 2px solid @fg1;
    background-color: @bg1;
    text-color: @fg0;
}

listview {
    border: 0;
    padding: 6px 0;
    scrollbar: true;
    scrollbar-width: 8px;
    lines: 10;
    columns: 1;
    dynamic: true;
}

scrollbar {
    width: 8px;
    padding: 0;
    handle-color: @accent;
    handle-width: 8px;
    border-radius: 4px;
    background-color: @bg1;
    margin: 0;
}

element {
    border: 0;
    padding: 8px 12px;
    margin: 2px 0;
    background-color: transparent;
    text-color: @fg0;
    border-radius: 6px;
    cursor: pointer;
    transition: all 200ms;
}

element:hover,
element:selected {
    background-color: @bg2;
    text-color: @accent2;
    border-radius: 8px;
}

element.active {
    background-color: @accent;
    text-color: @bg0;
    border-radius: 8px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
}

element-icon {
    background-color: transparent;
    size: 24px;
    cursor: inherit;
    margin: 0 8px 0 0;
}

error-message {
    padding: 16px;
    border: 2px solid @red;
    border-radius: 8px;
    background-color: @bg1;
    text-color: @red;
}
